{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${ANTIAFK_VERSION}",
	"name": "AntiAfk",
	"description": "Anti-AFK, ported from the Metamod plugin Anti-Afk (ABKAM). A one-second check walks every in-game human player: moving a WASD key or turning the view by aim_move_threshold_deg resets the idle timer (warmup and respawn states reset it too), after initial_warning_time the player is warned, the last five seconds count down, and at warning_interval the plugin kills the idle player (warnCount), escalating per max_warnings and ending with a kick (kick_instead_of_spec) or a move to spectators. Settings and phrases come from addons/configs/AntiAfk/settings.ini and addons/translations/antiafk.phrases.txt. No exported methods.",
	"author": "ABKAM, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/AntiAfk",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
